{
  "gateway": {
    "controlUi": {
      "enabled": false
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "logging": {
    "level": "debug",
    "file": "/home/node/.openclaw/logs/openclaw.log"
  },
  "models": {
    "providers": {
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "OPENAI_API_KEY"
        },
        "api": "openai-responses",
        "models": [
          {
            "id": "gpt-5.5",
            "name": "GPT-5.5",
            "reasoning": true,
            "input": ["text"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 400000,
            "maxTokens": 128000
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": "anthropic/claude-haiku-4-5-20251001",
      "thinkingDefault": "medium",
      "models": {
        "openai/gpt-5.5": {
          "params": {
            "thinking": "medium",
            "transport": "sse",
            "openaiWsWarmup": false
          }
        }
      },
      "memorySearch": {
        "enabled": false
      }
    }
  }
}
